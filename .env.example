MONGODB_URI=mongodb://127.0.0.1:27017/ener_scope
AUTH_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000

# Required on Vercel so /api/cron/tick is protected (also used by Vercel Cron)
CRON_SECRET=change-me-to-a-long-random-cron-secret

# SMTP credentials are configured in Admin → Email (saved per logged-in user in MongoDB).
# Do not put SMTP_USER / SMTP_PASS here.
